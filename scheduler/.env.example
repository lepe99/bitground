# MySQL 접속 정보 (DB_HOST는 host:port 형식)
DB_HOST=localhost:3307
DB_NAME=bitground
DB_USER=bitground
DB_PASSWORD=bitground

# 실행 모드: dev(6시간 주기 시즌/스플릿) | prod(매월 1·16일 시즌, 8·23일 스플릿)
TYPE=dev
# 기준 시각 고정(테스트용). 현재 시각을 쓰려면 "0000-00-00 00:00:00"
# 주의: 현재 시각은 가장 가까운 정시로 반올림된다 (17:32에 한 번 실행하면 18시 작업, dev면 시즌 정산까지 실행됨)
TEST_TIME="0000-00-00 00:00:00"
# 로컬 매시 실행 (docker compose --profile scheduler가 1로 설정). 비우면 한 번 실행하고 끝
RUN_HOURLY=
# 로컬 테스트용: 0시만이 아니라 매 실행마다 AI 인사이트를 다시 만든다 (Gemini 호출 약 10회/시간)
INSIGHT_EVERY_HOUR=
# 로그 형식: json(기본, Lambda·Docker·Loki용) | text(터미널에서 직접 실행할 때 읽기 쉽게)
LOG_FORMAT=
# 로그 레벨: debug | info(기본) | warn | error. debug면 임베딩 호출마다 지연 시간도 남긴다
LOG_LEVEL=

# 시즌·일일 작업 판정 기준 시간대 (Lambda 기본값은 UTC라 명시)
TIMEZONE=Asia/Seoul

# Google Gemini API 키 (AI 인사이트 생성, 비우면 인사이트 생략)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 네이버 뉴스 검색(NAVER API HUB) 키: 인사이트의 근거 기사. 비우면 시세만으로 작성 (백엔드와 같은 키)
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
# 인사이트 프롬프트 버전 (service/prompts/{버전}/). 비우면 코드의 기본값
INSIGHT_PROMPT_VERSION=

# 뉴스 아카이브: 매시간 네이버 뉴스를 Gemini로 임베딩해 Pinecone에 저장 (키가 없으면 생략)
PINECONE_API_KEY=
PINECONE_INDEX=bitground-news
NEWS_EMBED_MODEL=gemini-embedding-2
# 인덱스 차원과 같아야 함
NEWS_EMBED_DIM=768
# 분당 임베딩 요청 상한 (기본 80, Gemini 요청 한도에 맞춘다)
NEWS_EMBED_RPM=

# 새 시즌 이름
SEASON_NAME="데브 시즌"
# 시즌·스플릿 완료를 알릴 백엔드 주소
BACKEND_URL=http://localhost:8090
# 백엔드 /seasons/update 호출 시 X-Scheduler-Key 헤더로 보내는 공유 키 (application.yml의 season.update.key와 동일)
SEASON_UPDATE_KEY=
