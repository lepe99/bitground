# backend/.env 로 복사해서 사용 (Spring이 실행 디렉터리의 .env를 읽는다)

# MySQL (docker-compose 기본값)
DB_URL=jdbc:mysql://localhost:3307/bitground?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=bitground
DB_PASSWORD=bitground

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 프론트엔드 주소 (로그인 후 리다이렉트)
REACT_HOST=http://localhost:5173
# 브라우저 요청을 허용할 주소 (CORS·WebSocket, 쉼표로 여러 개). 지정하지 않으면 REACT_HOST만 허용
# CORS_ALLOWED_ORIGINS=https://bitground.kr,https://www.bitground.kr
# DB 커넥션 풀 크기 (기본 10)
# DB_POOL_SIZE=10

# OAuth2 / OIDC 클라이언트
# 각 콘솔의 Redirect URI: http://localhost:8090/login/oauth2/code/{google|naver|kakao}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# JWT 서명 키 (HS512: 64바이트 이상)
JWT_SECRET=

# 이미지 스토리지 (로컬: docker-compose S3Mock / 운영: 엔드포인트·키를 비우고 IAM 역할 사용)
STORAGE_BUCKET=bitground
STORAGE_REGION=ap-northeast-2
STORAGE_ENDPOINT=http://localhost:9090
STORAGE_ACCESS_KEY=local
STORAGE_SECRET_KEY=local

# 네이버 뉴스 검색 API: 네이버 클라우드 NAVER API HUB Application의 인증 정보 (Developers Center 키는 사용 불가)
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 스케줄러(Go)와 공유하는 시즌 갱신 키
SEASON_UPDATE_KEY=

# dev | prod
SCHEDULER_SETTING=dev
