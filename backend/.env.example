# backend/.env 로 복사해서 사용 (Spring이 실행 디렉터리의 .env를 읽는다)

# MySQL (docker-compose 기본값)
DB_URL=jdbc:mysql://localhost:3307/bitground?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=bitground
DB_PASSWORD=bitground

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 프론트엔드 주소 (CORS, 로그인 후 리다이렉트)
REACT_HOST=http://localhost:5173

# OAuth2 / OIDC 클라이언트
# 각 콘솔의 Redirect URI: http://localhost:8090/login/oauth2/code/{google|naver|kakao}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# JWT 서명 키 (HS512: 64바이트 이상)
JWT_SECRET=

# Object Storage
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_BUCKET=bitground

# 네이버 뉴스 검색 API
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 스케줄러(Go)와 공유하는 시즌 갱신 키
SEASON_UPDATE_KEY=

# dev | prod
SCHEDULER_SETTING=dev
