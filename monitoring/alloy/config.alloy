// Grafana Alloy: 백엔드·스케줄러 컨테이너 로그(JSON)를 수집해 Loki로 보낸다.
// 백엔드는 LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash 로 실행되어야 JSON으로 출력된다.
// 스케줄러는 기본이 JSON(log/slog)이고 필드 이름(level, message, @timestamp)을 백엔드와 맞췄다.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "name"
    values = ["bitground-backend"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "backend" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { app = "bitground-backend" }
  forward_to = [loki.process.backend.receiver]
}

loki.process "backend" {
  // JVM이 시작할 때 한 번 찍는 텍스트 줄(JSON이 아님)은 버린다
  stage.drop {
    expression = "^Picked up JAVA_TOOL_OPTIONS"
  }

  stage.json {
    expressions = {
      level   = "level",
      logger  = "logger_name",
      traceId = "traceId",
      userId  = "userId",
    }
  }

  // level 은 값 종류가 적어 라벨로, traceId·userId 는 값이 많아 구조화 메타데이터로 둔다
  stage.labels {
    values = { level = "" }
  }

  stage.structured_metadata {
    values = {
      traceId = "",
      userId  = "",
      logger  = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

// ── 스케줄러 (로컬 매시 실행 컨테이너. 운영은 Lambda → CloudWatch)
discovery.docker "scheduler" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "name"
    values = ["bitground-scheduler"]
  }
}

discovery.relabel "scheduler" {
  targets = discovery.docker.scheduler.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "scheduler" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.scheduler.output
  labels     = { app = "bitground-scheduler" }
  forward_to = [loki.process.scheduler.receiver]
}

loki.process "scheduler" {
  stage.json {
    expressions = {
      level  = "level",
      job    = "job",
      runId  = "run_id",
      period = "period",
      symbol = "symbol",
    }
  }

  // level·job(작업 이름 10개 남짓)은 라벨로, 실행마다 바뀌는 run_id·period·symbol은 구조화 메타데이터로 둔다
  stage.labels {
    values = { level = "", job = "" }
  }

  stage.structured_metadata {
    values = {
      runId  = "",
      period = "",
      symbol = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
