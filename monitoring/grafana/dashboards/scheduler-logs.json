{
  "uid": "bitground-scheduler",
  "title": "Bitground 스케줄러",
  "schemaVersion": 39,
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "level", "label": "레벨", "type": "custom", "query": "ERROR,WARN,INFO,DEBUG",
        "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "job", "label": "작업", "type": "query", "datasource": {"type": "loki", "uid": "loki"},
        "query": {"label": "job", "stream": "{app=\"bitground-scheduler\"}", "type": 1},
        "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}, "refresh": 2
      },
      {"name": "runId", "label": "run_id", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}
    ]
  },
  "panels": [
    {
      "type": "timeseries", "title": "작업별 실패 (1시간)",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{
        "refId": "A", "legendFormat": "{{job}}",
        "expr": "sum by (job) (count_over_time({app=\"bitground-scheduler\", level=\"ERROR\", job!=\"\"} |= \"작업 \" [1h]))"
      }],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 60}, "decimals": 0}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "작업별 소요 시간 (ms)",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{
        "refId": "A", "legendFormat": "{{job}}",
        "expr": "max by (job) (max_over_time({app=\"bitground-scheduler\", job=~\"$job\", job!=\"\"} |= \"작업 완료\" | json | unwrap duration_ms [1h]))"
      }],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Gemini 토큰 (프롬프트 버전별, 1시간 합계)",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "refId": "A", "legendFormat": "입력 {{prompt_version}}",
          "expr": "sum by (prompt_version) (sum_over_time({app=\"bitground-scheduler\"} |= \"Gemini 호출\" | json | unwrap input_tokens [1h]))"
        },
        {
          "refId": "B", "legendFormat": "출력 {{prompt_version}}",
          "expr": "sum by (prompt_version) (sum_over_time({app=\"bitground-scheduler\"} |= \"Gemini 호출\" | json | unwrap output_tokens [1h]))"
        }
      ],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 60}, "decimals": 0}, "overrides": []}
    },
    {
      "type": "logs", "title": "로그 (레벨·작업·run_id로 거르기)",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 16},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{
        "refId": "A",
        "expr": "{app=\"bitground-scheduler\", level=~\"$level\", job=~\"$job\"} | runId=~\"$runId.*\" | json | line_format \"{{if .period}}[{{.period}}] {{end}}{{if .job}}{{.job}} · {{end}}{{.message}}{{if .error}} — {{.error}}{{end}}\""
      }],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}
    }
  ]
}
