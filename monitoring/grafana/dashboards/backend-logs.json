{
  "uid": "bitground-logs",
  "title": "Bitground 백엔드 로그",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "레벨",
        "type": "custom",
        "query": "ERROR,WARN,INFO,DEBUG",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "traceId",
        "label": "traceId",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "userId",
        "label": "userId",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "레벨별 로그 수 (1분)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({app=\"bitground-backend\", level=~\"$level\", level!=\"\"}[1m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "느린 호출 · 실패한 비즈니스 요청 (@Loggable)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"bitground-backend\", level=\"WARN\"} |~ \"SLOW|FAILED code=\" | json | line_format \"{{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "로그 (traceId / userId 로 필터)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 16
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"bitground-backend\", level=~\"$level\"} | traceId=~\"$traceId.*\" | userId=~\"$userId.*\" | json | line_format \"{{.message}}\""
        }
      ]
    }
  ]
}
