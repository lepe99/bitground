// 운영 모니터링 서버의 Grafana Alloy: 스케줄러 Lambda 로그 수신기.
// CloudWatch Logs(수집 A·쓰기 B) → 구독 필터 → lambda-promtail(VPC 안) → 여기(3500) → Loki.
// 앱 서버가 꺼져 있어도 Lambda 로그는 이 경로로 계속 쌓인다.

loki.source.api "lambda" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }

  labels     = { app = "bitground-scheduler", env = "prod" }
  forward_to = [loki.process.scheduler.receiver]
}

// 스케줄러 JSON 로그(log/slog) 정리. 로컬 설정(monitoring/alloy/config.alloy)과 같은 규칙.
// Lambda 런타임이 찍는 START/END/REPORT 줄은 JSON이 아니어서 필드 추출 없이 그대로 남는다 (실행 시간·메모리 확인용)
loki.process "scheduler" {
  stage.json {
    expressions = {
      level  = "level",
      job    = "job",
      runId  = "run_id",
      period = "period",
      symbol = "symbol",
    }
  }

  // level·job(작업 이름 10개 남짓)은 라벨로, 실행마다 바뀌는 run_id·period·symbol은 구조화 메타데이터로 둔다
  stage.labels {
    values = { level = "", job = "" }
  }

  stage.structured_metadata {
    values = {
      runId  = "",
      period = "",
      symbol = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
