# API 서버 (프론트는 CloudFront + S3라 여기서 서빙하지 않는다)
# Caddy가 Let's Encrypt 인증서를 자동으로 받고 갱신한다 (80·443이 인터넷에 열려 있어야 함)
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	# 외부 가동 상태 확인(UptimeRobot 등)용. 백엔드가 DB·Redis까지 받을 준비가 됐는지 본다 (상세 내용은 응답하지 않음)
	handle /healthz {
		rewrite * /actuator/health/readiness
		reverse_proxy backend:8091
	}

	# REST API와 WebSocket. Caddy는 받은 X-Forwarded-For를 믿지 않고 실제 접속 IP로 다시 채운다
	# (백엔드의 IP별 요청 제한을 헤더 위조로 피할 수 없게)
	handle {
		reverse_proxy backend:8090
	}

	log {
		output stdout
		format json
	}
}
