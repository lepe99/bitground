# API 서버 (프론트는 CloudFront + S3라 여기서 서빙하지 않는다)
# Caddy가 Let's Encrypt 인증서를 자동으로 받고 갱신한다 (80·443이 인터넷에 열려 있어야 함)
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	# 외부 가동 상태 확인(UptimeRobot 등)용. 백엔드가 DB·Redis까지 받을 준비가 됐는지 본다 (상세 내용은 응답하지 않음)
	handle /healthz {
		rewrite * /actuator/health/readiness
		reverse_proxy backend:8091
	}

	# REST API와 WebSocket. Caddy는 받은 X-Forwarded-For를 믿지 않고 실제 접속 IP로 다시 채운다
	# (백엔드의 IP별 요청 제한을 헤더 위조로 피할 수 없게)
	handle {
		reverse_proxy backend:8090
	}

	log {
		output stdout
		format json
	}
}

# Grafana (모니터링 서버, 프라이빗 서브넷). 인터넷에는 이 앱 서버의 Caddy만 노출된다
# 기본 인증으로 한 겹 더 막아 봇·무차별 대입이 Grafana 로그인 화면까지 오지 못하게 한다
# GRAFANA_BASIC_AUTH_HASH는 bcrypt 해시를 base64로 인코딩한 값 (bcrypt의 '$'는 compose .env에서 변수로 해석되므로)
{$GRAFANA_DOMAIN} {
	encode zstd gzip

	basic_auth {
		{$GRAFANA_BASIC_AUTH_USER} {$GRAFANA_BASIC_AUTH_HASH}
	}

	reverse_proxy {$MONITORING_HOST}:3000 {
		# 기본 인증 헤더를 넘기면 Grafana가 자기 계정 정보로 해석해 401을 낸다
		header_up -Authorization
	}

	log {
		output stdout
		format json
	}
}
