# deploy/app/backend.env 로 복사 (커밋 금지). 운영에서는 배포 때 SSM Parameter Store에서 만든다
# DB·Redis 주소와 비밀번호는 compose.yml이 넣는다

# 프론트 주소 (로그인 후 리다이렉트, CORS·WebSocket 허용)
REACT_HOST=https://www.example.kr
CORS_ALLOWED_ORIGINS=https://www.example.kr

# OAuth2 (각 콘솔의 Redirect URI: https://<API_DOMAIN>/login/oauth2/code/{google|naver|kakao})
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

JWT_SECRET=

# 이미지 업로드: AWS S3. 엔드포인트·키를 비우면 EC2 IAM 역할을 쓴다
# (컨테이너에서 인스턴스 메타데이터에 닿으려면 EC2의 IMDSv2 홉 제한을 2로 둬야 한다)
STORAGE_BUCKET=
STORAGE_REGION=ap-northeast-2
STORAGE_PUBLIC_URL=

NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 쓰기 Lambda(B)와 공유하는 시즌 갱신 키
SEASON_UPDATE_KEY=
