# deploy/app/.env 로 복사 (커밋 금지). 운영에서는 배포 때 SSM Parameter Store에서 만든다
API_DOMAIN=api.example.kr
ACME_EMAIL=
MONITORING_HOST=10.0.128.10

# Grafana를 앱 서버 Nginx로 중계 (기본 인증 + Grafana 로그인)
GRAFANA_DOMAIN=grafana.example.kr
GRAFANA_BASIC_AUTH_USER=
# base64(bcrypt): docker run --rm httpd:2.4-alpine htpasswd -nbB x "$P" | cut -d: -f2 | tr -d '\r\n' | base64 -w0
GRAFANA_BASIC_AUTH_HASH=

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 배포할 백엔드 이미지 (CI가 GHCR에 올린 arm64 이미지)
BACKEND_IMAGE=ghcr.io/lepe99/bitground-backend
# CI가 붙이는 태그: 커밋 해시(배포 시 이것으로 고정) 또는 브랜치 이름(main, dev)
BACKEND_TAG=main
